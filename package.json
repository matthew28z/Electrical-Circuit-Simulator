{
  "name": "zimaris-lab",
  "version": "0.0.8",
  "type": "module",
  "main": "src/app/logic/menu.ts",
  "workspaces": [
    "src/calculation",
    "src/app"
  ],
  "scripts": {
    "test": "vitest --browser",
    "test:ui": "vitest --ui --browser",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:browser": "vitest --config=vitest.browser.config.js",

    "bump:zileb:patch": "npm run bump:patch --workspace=ZiLE-Basic",
    "bump:zileb:minor": "npm run bump:minor --workspace=ZiLE-Basic",
    "bump:zileb:major": "npm run bump:major --workspace=ZiLE-Basic",

    "bump:zilui:patch": "npm run bump:patch --workspace=ZiLUI",
    "bump:zilui:minor": "npm run bump:minor --workspace=ZiLUI",
    "bump:zilui:major": "npm run bump:major --workspace=ZiLUI",

    "bump:zil:patch": "npm version patch --no-git-tag-version",
    "bump:zil:minor": "npm version minor --no-git-tag-version",
    "bump:zil:major": "npm version major --no-git-tag-version"
  },
  "keywords": [
    "circuits",
    "simulation",
    "d3",
    "js",
    "zimaris-lab"
  ],
  "author": "Matthaios Zimaris",
  "license": "CC BY-NC 4.0",
  "description": "Zimaris Lab is a software that helps visualise circuits and is mainly targeted for students.",
  "dependencies": {
    "d3": "^7.9.0",
    "mongodb": "^7.2.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^25.5.0",
    "@vitest/browser": "^4.1.0",
    "@vitest/browser-playwright": "^4.1.0",
    "playwright": "^1.58.2",
    "typescript": "^6.0.2",
    "vite": "^7.3.1",
    "vite-plugin-inspect": "^11.3.3",
    "vitest": "^4.1.0"
  }
}
